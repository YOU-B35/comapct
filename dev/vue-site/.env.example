# 默认走后端；仅本地调试纯前端 Demo 时改为 false
VITE_USE_TEMU_BACKEND=true
VITE_TEMU_API_URL=http://localhost:18080
VITE_TEMU_API_PROXY=http://localhost:18080

# AI 生图独立模块（密钥请写在 .env.local，勿提交）
# 上游走 hyhacct 异步 /v1/api/generate，勿依赖 /v1/images/generations
VITE_GPT_IMAGE_API_KEY=
VITE_GPT_IMAGE_PROXY_TARGET=https://api.hyhacct.com

# 自媒体运营（独立 Vue 模块）：默认直连线上 SAU API，勿依赖本机 :5409
# VITE_SAU_API_BASE_URL=https://automedia.yoto.work/api
# 仅调试本机 SAU 时才设代理，例如 VITE_SAU_API_PROXY=http://127.0.0.1:5409 且 BASE 改 /sau-api

# 自动上货走 Java BFF `/api/commander`（账密配在 Java 环境变量 CROSSHUB_COMMANDER_*）
# VITE_COMMANDER_API_BASE=

# —— 生产构建见 .env.production（VITE_BASE_PATH=/crosshub/，API 走同域相对路径）
# 部署：powershell -File scripts/deploy-server.ps1
# 默认不上传本地 DB；若要覆盖线上库：CROSSHUB_UPLOAD_DB=1

