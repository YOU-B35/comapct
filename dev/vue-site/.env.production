# 线上构建（npm run build / 部署脚本）专用
# 静态资源挂在 https://www.yoto.work/crosshub/
VITE_BASE_PATH=/crosshub/

# 同域 Nginx 反代 /api/* → Java :18080，勿写成 localhost
VITE_USE_TEMU_BACKEND=true
VITE_TEMU_API_URL=

# AI 生图：Key 由部署脚本从 .env.local / 环境变量注入，勿把真实 Key 提交 git
# 留空即可；勿写 VITE_GPT_IMAGE_API_KEY= 空赋值，否则会盖掉 .env.local
VITE_GPT_IMAGE_PROXY_TARGET=https://api.hyhacct.com

# 自媒体默认直连线上 SAU（与本地一致）
# VITE_SAU_API_BASE_URL=https://automedia.yoto.work/api
