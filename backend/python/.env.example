# Temu 爬虫环境变量（复制为 .env）
# 默认有头模式 + Playwright 内置 Chromium（无需本机浏览器）
TEMU_HEADLESS=0
# 留空 = Playwright 内置 Chromium；需要系统浏览器时设为 chrome / msedge
TEMU_BROWSER_CHANNEL=

# 持久化登录态目录（勿提交 git）
# TEMU_PROFILE_DIR=./.temu-browser-profile

# 请求间隔（毫秒），模拟人工操作
TEMU_MIN_DELAY_MS=800
TEMU_MAX_DELAY_MS=2200

# 后台无头数据采集时跳过图片/字体/媒体；人工登录与验证码窗口不受影响
CRAWL_BLOCK_HEAVY_RESOURCES=0

# Temu 销售接口：只对超时、网络中断与 429/5xx 进行退避重试
TEMU_API_REQUEST_TIMEOUT_MS=45000
TEMU_API_MAX_RETRIES=2
TEMU_API_RETRY_BASE_SECONDS=1.0

# AliExpress 只读订单接口：仅对超时、网络中断与 429/5xx 重试
AE_API_MAX_RETRIES=2
AE_API_RETRY_BASE_SECONDS=1.0

# 紫鸟 WebDriver（复制为 .env 并填写；勿提交 git）
# 文档: https://open.ziniao.com/docSupport?docId=98
# ZINIAO_COMPANY=企业全称（紫鸟左上角显示）
# ZINIAO_USERNAME=自动化子账号
# ZINIAO_PASSWORD=
# ZINIAO_CLIENT_PATH=C:\Program Files\ziniao\ziniao.exe
# ZINIAO_SOCKET_PORT=16851

# Amazon AI 助手 LLM 通道（DeepSeek，OpenAI 兼容接口；真实 Key 只放 .env，勿提交 git）
# 配置 LLM_API_KEY 即自动启用；AMAZON_CHAT_LLM_ENABLED=1 可强制启用，=0 强制关闭
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash-vision-exp
LLM_TIMEOUT_SECONDS=60
AMAZON_CHAT_LLM_ENABLED=0

# 紫鸟 CLI（普通模式 Amazon 店铺发现、同步与 LLM 实时取数共用）
# 未安装时仅能使用 WebDriver 开发者模式；本项目装在 tools/ziniao-cli 时可显式指定路径
# ZINIAO_CLI_BIN=D:\YOTO-SASS\SaaS-HZ_WEB_Demo\tools\ziniao-cli\node_modules\.bin\ziniao-cli.cmd
# AMAZON_ZCLAW_FALLBACK_ENABLED=1
# AMAZON_ZCLAW_ORDER_MAX_PAGES=5
# AMAZON_CHAT_TOOL_TIMEOUT_SECONDS=20
# 工具结果进 LLM 的默认字符上限（默认 2000）
# AGENT_TOOL_RESULT_MAX_CHARS=2000
# page content 工具结果字符上限（默认 12000；账户健康页指标较长时适当调大）
# AGENT_PAGE_CONTENT_MAX_CHARS=12000
# LLM 工具调用最大轮数（默认 8）
# AGENT_MAX_ROUNDS=8

# 验证码人工验证最长等待（秒），默认 300；命中后唤起紫鸟浏览器由人工完成
# AMAZON_CHAT_CAPTCHA_TIMEOUT_SECONDS=300
