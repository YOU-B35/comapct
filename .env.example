# CrossHub Helper - Development & Deploy Configuration
# Copy this to .env and fill in your values
# These env vars are used by build scripts and deployment tools

# ==================== SSH Deploy Config ====================
# Remote host for deploying services
SSH_HOST=124.223.27.98

# SSH username
SSH_USER=root

# Path to SSH private key (defaults to ~/.ssh/lhkp-o3wazsuv)
# Windows: C:/Users/YourName/.ssh/lhkp-o3wazsuv
# Linux:   /home/yourname/.ssh/lhkp-o3wazsuv
SSH_KEY=

# SSH connection timeout in milliseconds (default: 60000)
SSH_TIMEOUT=60000

# ==================== Java Build & Deploy ====================
# Path to Java project JAR output directory
# If not set, defaults to backend/java/target
JAR_DIR=

# Custom Java API URL for build scripts
JAVA_API_URL=https://www.yoto.work

# ==================== Python Desktop App ====================
# Health check server port (default: 18765)
AGENT_HEALTH_PORT=18765

# Panel server port (default: 18766)
PANEL_PORT=18766

# ==================== Local Development ====================
# Set to 1 to enable debug logging
DEBUG=0

# Set to 1 to skip pyinstaller windowed mode (show console)
DEBUG_CONSOLE=0
